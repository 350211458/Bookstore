# Spec 06 — Docker Compose variables (non-secret template).
# Copy to `.env` for local use:            cp .env.example .env
# Copy to `.env.production` on the deploy host for CD deploys (never commit secrets).

# PostgreSQL password substituted into each ConnectionStrings__*Db value.
POSTGRES_PASSWORD=postgres

# Image registry prefix and tag used by docker-compose.yaml.
# Local builds default to "local" (e.g. local/bookstore-identity-api:latest).
# On the production host set IMAGE_REGISTRY=ghcr.io/<owner>/<repo> ALL LOWERCASE (Docker
# rejects uppercase repository names, e.g. use ghcr.io/350211458/bookstore, NOT
# ghcr.io/350211458/Bookstore) so `docker compose pull` pulls the CD-pushed images.
IMAGE_REGISTRY=local
IMAGE_TAG=latest
